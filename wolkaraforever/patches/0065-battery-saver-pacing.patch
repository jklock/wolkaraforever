+// Battery Saver: a frame cap applied at the presentation call the guest itself makes.
+//
+// Apple documents three kinds of presentation on a command buffer: immediate
+// (presentDrawable:), timed (presentDrawable:atTime:) and minimum-duration
+// (presentDrawable:afterMinimumDuration:), the last of which "holds the previous drawable
+// for at least the specified duration" (MTLCommandBuffer). A cap is therefore expressible
+// in the guest's own presentation calls - no second swizzle, no separate render loop and no
+// touch on what the guest draws:
+//
+//   immediate          -> presentDrawable:afterMinimumDuration: with the cap's interval
+//   minimum-duration   -> the game's duration, or the cap's, whichever is longer
+//   timed (atTime:)    -> the game's time, or no-earlier-than the previous frame for this
+//                         layer plus the interval, whichever is later
+//
+// Off is transparent: the original call is made, with the original arguments, and nothing
+// here computes anything. A game that presents through several layers paces each of them
+// on its own, because the target time is kept on the drawable's layer.
+//
+// What this cannot do is change how often the guest renders: it is a presentation cap, so a
+// capped session presents fewer frames and saves the GPU work those frames would have done.
+// The measurement that matters is therefore presented frames per second, which is what
+// AKMetalCurrentFPS already reports from CAMetalDrawable.presentedTime - not the rate at
+// which drawables are acquired.
+static os_unfair_lock s_paceLock = OS_UNFAIR_LOCK_INIT;
+static double s_paceInterval = 0.0;        // cached, seconds; 0 = no cap
+static double s_paceNextRefresh = 0.0;     // when the cache above must be re-resolved
+static atomic_bool s_paceWanted = false;   // this guest was started with a cap or an AFK timer
+static atomic_bool s_paceDimmed = false;   // the AppKit adapter's idle coordinator is dimming
+static char paceMarker;                    // per-layer target time of the next presentation
+
+// Counts of what the pacing path did, for the fixture and for a session log. Each one is one
+// relaxed atomic increment in a path that only runs while a cap is in force.
+static atomic_uint_fast64_t s_paceImmediate, s_paceExtended, s_paceRaised, s_paceKept, s_paceBypassed;
+
+__attribute__((visibility("default"))) void AKMetalBatterySaverPacingCounts(uint64_t *immediate,
+                                                                           uint64_t *extended,
+                                                                           uint64_t *raised,
+                                                                           uint64_t *kept,
+                                                                           uint64_t *bypassed) {
+    if (immediate) *immediate = atomic_load(&s_paceImmediate);
+    if (extended) *extended = atomic_load(&s_paceExtended);
+    if (raised) *raised = atomic_load(&s_paceRaised);
+    if (kept) *kept = atomic_load(&s_paceKept);
+    if (bypassed) *bypassed = atomic_load(&s_paceBypassed);
+}
+
+// The interval the next presentation is held for, in seconds; 0 when nothing caps it.
+//
+// The environment - charger, Low Power Mode, thermal state - can change during a session,
+// and a thermal state is exactly what a cap is for. Reading it is resolved at most once a
+// second rather than per frame: a device query on the render path would cost more than the
+// frames it saves. The dim is applied immediately through its notification instead.
+static double AKBatterySaverPaceInterval(void) {
+    if (!atomic_load(&s_paceWanted)) return 0.0;
+    double now = CACurrentMediaTime();
+    os_unfair_lock_lock(&s_paceLock);
+    if (now < s_paceNextRefresh) {
+        double interval = s_paceInterval;
+        os_unfair_lock_unlock(&s_paceLock);
+        return interval;
+    }
+    s_paceNextRefresh = now + 1.0;
+    os_unfair_lock_unlock(&s_paceLock);
+    AKBatterySaverFramePolicy policy = AKBatterySaverResolvedPolicy(atomic_load(&s_paceDimmed));
+    double interval = AKBatterySaverFramePolicyInterval(policy);
+    os_unfair_lock_lock(&s_paceLock);
+    s_paceInterval = interval;
+    os_unfair_lock_unlock(&s_paceLock);
+    return interval;
+}
+
+// The earliest host time this drawable's layer may present at, after this frame.
+//
+// Kept on the layer rather than in a global: a game that presents through two layers would
+// otherwise make them pace against each other, and one that opens a second window would
+// inherit a target time belonging to the first.
+static CFTimeInterval AKBatterySaverPaceTarget(id<MTLDrawable> drawable, CFTimeInterval interval) {
+    CALayer *layer = nil;
+    if ([drawable isKindOfClass:NSObject.class] && [(NSObject *)drawable respondsToSelector:@selector(layer)])
+        layer = [(id<CAMetalDrawable>)drawable layer];
+    if (!layer) return 0.0;   // no layer to remember: the game keeps its own timing
+    CFTimeInterval now = CACurrentMediaTime();
+    NSNumber *previous = objc_getAssociatedObject(layer, &paceMarker);
+    // A layer that has not presented recently starts from now: an old target is not credit
+    // that may be spent as a burst of frames.
+    CFTimeInterval floor = previous ? previous.doubleValue : now;
+    if (floor < now - 1.0) floor = now;
+    CFTimeInterval target = floor + interval;
+    objc_setAssociatedObject(layer, &paceMarker, @(target), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    return target;
+}
+
+// Watches the one state that must apply immediately: the AFK dim's fixed 10 FPS.
+static void AKBatterySaverObserveDim(void) {
+    [NSNotificationCenter.defaultCenter addObserverForName:AKBatterySaverDimDidChangeNotification
+                                                    object:nil queue:nil
+                                                usingBlock:^(NSNotification *note) {
+        BOOL dimmed = [note.userInfo[AKBatterySaverDimmedKey] boolValue];
+        atomic_store(&s_paceDimmed, dimmed);
+        // Re-resolve at the next presentation rather than one second later.
+        os_unfair_lock_lock(&s_paceLock);
+        s_paceNextRefresh = 0.0;
+        os_unfair_lock_unlock(&s_paceLock);
+    }];
+}
