+static void observedPresent(id command,SEL selector,id<MTLDrawable> drawable) {
+    markCapture(command,drawable); notePresented(command);
+    double interval=AKBatterySaverPaceInterval();
+    // Off, or nothing capped: the guest's own call with the guest's own arguments. A guest
+    // started without Battery Saver does not even reach the counter below: its presentation
+    // path is the one it had before this feature existed.
+    if(interval<=0.0) { if(atomic_load(&s_paceWanted)) atomic_fetch_add(&s_paceBypassed,1); originalPresent(command,selector,drawable); return; }
+    // Immediate presentation has no duration to lengthen, so it becomes a minimum-duration
+    // presentation: the previous drawable is held for the cap's interval instead of being
+    // replaced as soon as the next one is ready.
+    if(originalPresentAfter) { atomic_fetch_add(&s_paceImmediate,1); originalPresentAfter(command,selector,drawable,interval); return; }
+    // This runtime has no minimum-duration presentation (the simulator's Metal does not
+    // implement it; the device's does). Timed presentation is Apple's other documented way
+    // to say "not before", so the same cap is applied there: the guest asked for "as soon as
+    // possible", and the cap says when that is.
+    CFTimeInterval target=AKBatterySaverPaceTarget(drawable,interval);
+    if(target<=0.0) target=CACurrentMediaTime()+interval;
+    atomic_fetch_add(&s_paceImmediate,1);
+    originalPresentAt(command,selector,drawable,target);
+}
+static void observedPresentAt(id command,SEL selector,id<MTLDrawable> drawable,CFTimeInterval time) {
+    markCapture(command,drawable); notePresented(command);
+    double interval=AKBatterySaverPaceInterval();
+    if(interval<=0.0) { if(atomic_load(&s_paceWanted)) atomic_fetch_add(&s_paceBypassed,1); originalPresentAt(command,selector,drawable,time); return; }
+    // atTime: is the guest's own timing, so it is preserved: the frame is presented no
+    // earlier than the cap allows, and never earlier than the guest asked for.
+    CFTimeInterval target=AKBatterySaverPaceTarget(drawable,interval);
+    if(target>time) { atomic_fetch_add(&s_paceRaised,1); originalPresentAt(command,selector,drawable,target); }
+    else { atomic_fetch_add(&s_paceKept,1); originalPresentAt(command,selector,drawable,time); }
+}
+static void observedPresentAfter(id command,SEL selector,id<MTLDrawable> drawable,CFTimeInterval time) {
+    markCapture(command,drawable); notePresented(command);
+    double interval=AKBatterySaverPaceInterval();
+    if(interval<=0.0) { if(atomic_load(&s_paceWanted)) atomic_fetch_add(&s_paceBypassed,1); originalPresentAfter(command,selector,drawable,time); return; }
+    // The guest asked for a minimum duration of its own. A longer one is its decision and is
+    // kept; a shorter one is raised to the cap.
+    if(time>=interval) { atomic_fetch_add(&s_paceKept,1); originalPresentAfter(command,selector,drawable,time); }
+    else { atomic_fetch_add(&s_paceExtended,1); originalPresentAfter(command,selector,drawable,interval); }
+}
