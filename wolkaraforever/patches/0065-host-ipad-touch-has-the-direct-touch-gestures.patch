# WolkaraForever layer patch 0065 - host: iPad touch has the mobile direct-touch gestures
#
# Why: 0055 gave the host view its direct-touch gestures (tap, hold, hold-slide, pinch) behind its own
# check, which compares the stored interface mode to the literal "ios". iPad touch ("ipadtouch", the
# TouchPlay add-on's interface, chosen in the launcher) plays the game by touch the same way, and the
# layer's own controls already treat it as a mobile interface. The host now asks one more question:
# AKMobileInterface() is YES for "ios", as before, or when AKInterfaceModeIsTouchPlay() - whose header
# the overlay places beside AppKit.m - says iPad touch is the stored mode. Nothing else changes:
# "ipados", "iosduo", "auto", a missing value and a value this build does not recognise get exactly
# the host they got before. The AppKit views test (0060) states the rule: the host takes several
# fingers and has the pinch in "ios" and "ipadtouch", and one finger and no pinch in "ipados",
# "iosduo" and "auto".
#
# Applies after: 0064-controller-touchpad-mouse-handoff-test.patch (it builds on 0060-host-multitouch-contract-per-interface.patch)
# Applies to: translation/AppKit/AppKit.m, tests/test_appkit_views.m
# Upstream: no (the interface mode lives in the WolkaraForever layer).
#
--- a/tests/test_appkit_views.m
+++ b/tests/test_appkit_views.m
@@ -192,6 +192,17 @@ int main(void) { @autoreleasepool {
     [defaults setObject:@"ios" forKey:@"WolkaraForeverInterfaceModeV1"];
     plainHost=[NSClassFromString(@"AKHostView") new];
     assert(plainHost.multipleTouchEnabled && [plainHost valueForKey:@"_pinch"] != nil);
+    // iPad touch (the TouchPlay interface) gets them too.
+    [defaults setObject:@"ipadtouch" forKey:@"WolkaraForeverInterfaceModeV1"];
+    plainHost=[NSClassFromString(@"AKHostView") new];
+    assert(plainHost.multipleTouchEnabled && [plainHost valueForKey:@"_pinch"] != nil);
+    // Every other value keeps the host it had before iPad touch existed: iPadOS, iOS on Duo and
+    // Automatic take one finger and have no pinch, exactly as with no value at all.
+    for (NSString *other in @[@"ipados", @"iosduo", @"auto"]) {
+        [defaults setObject:other forKey:@"WolkaraForeverInterfaceModeV1"];
+        plainHost=[NSClassFromString(@"AKHostView") new];
+        assert(!plainHost.multipleTouchEnabled && [plainHost valueForKey:@"_pinch"] == nil);
+    }
     [defaults removeObjectForKey:@"WolkaraForeverInterfaceModeV1"];
     [defaults setBool:YES forKey:AKTouchControlsDefaultsKey];
     id host=[NSClassFromString(@"AKHostView") new];
--- a/translation/AppKit/AppKit.m
+++ b/translation/AppKit/AppKit.m
@@ -5,6 +5,7 @@
 #import "TouchControls.h"
 #import "AKTouchEventPump.h"
 #import "TouchGamepadLayout.h"
+#import "InterfaceMode.h"
 
 // The guest screen's pixels per point, defined in Screens.m.
 CGFloat AKGuestBackingScale(void);
@@ -287,13 +288,15 @@ NSEventModifierFlags AKModifiersReconciled(NSEventModifierFlags held, NSEventMod
 - (BOOL)ak_needsTrackingEvents;
 @end
 
-// The interface the user chose: "ios" is the mobile (iPhone/Duo) arrangement, anything
-// else - including a missing or hand-edited value - is iPadOS, the interface every release
-// through v1.0.7 has had. Read on each use, so a value written between two guests in one
-// process is seen by the second. The launcher owns the key; the layer only reads it.
+// The interface the user chose: "ios" is the mobile (iPhone/Duo) arrangement, and "ipadtouch" (iPad touch,
+// the TouchPlay interface, AKInterfaceModeIsTouchPlay()) has the same direct-touch gestures; anything
+// else - "iosduo", "auto", a missing or hand-edited value - is what it was before iPad touch existed:
+// iPadOS, the interface every release through v1.0.7 has had. Read on each use, so a value written
+// between two guests in one process is seen by the second. The launcher owns the key; the layer only
+// reads it.
 static BOOL AKMobileInterface(void) {
     id value = [NSUserDefaults.standardUserDefaults objectForKey:@"WolkaraForeverInterfaceModeV1"];
-    return [value isKindOfClass:NSString.class] && [(NSString *)value isEqualToString:@"ios"];
+    return ([value isKindOfClass:NSString.class] && [(NSString *)value isEqualToString:@"ios"]) || AKInterfaceModeIsTouchPlay();
 }
 
 @implementation AKHostView { CGPoint _last; NSEventModifierFlags _mods; BOOL _pressedRight, _pressedLeft, _pointerInside, _softwareCursor; UIImageView *_cursorView; UIPointerInteraction *_pointer; UIPointerStyle *_gamePointerStyle; unsigned _hoverUpdates, _pointerUpdates, _cursorVisibilityReasons; NSTimeInterval _pointerReportTime; CGPoint _cursorHotSpot;
