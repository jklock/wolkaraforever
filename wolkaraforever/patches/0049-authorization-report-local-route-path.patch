# WolkaraForever layer patch 0049 - authorization: report how iOS classifies the local route
#
# Why: a launch on mobile data (no Wi-Fi) failed after the whole retry window with a
# report that did not say why. Measured on 2026-11-05 (iPhone Duo, iOS 27.2, cable
# plugged in, phone on mobile data): the route came up, the device's developer service
# reset the connection, and Network.framework classified the route as
# "utun12/0 cellular=1 expensive=1". Every report now carries that classification, so
# a refused launch on mobile data names its cause. Read-only: nothing is sent.
# Applies to: authorization/App/LocalAuthorization.m
# Upstream: candidate (not submitted).
#
diff --git a/authorization/App/LocalAuthorization.m b/authorization/App/LocalAuthorization.m
index 525f894..1a22cff 100644
