 @property(nonatomic) NSUInteger serviceGeneration;
+// What iOS says the route runs over, read off the main queue by provider replies.
+@property(atomic,copy) NSString *tunnelPath;
 @end
 
+// How iOS classifies the private route. A tunnel tagged with a cellular delegate
+// counts as cellular and expensive, and the device's own developer service refuses
+// connections that arrive on it (xnu's IFNET_IS_CELLULAR follows if_delegated).
+// A UDP connection sends nothing until written to, so this only reads the path.
+static void TKDescribeTunnelPath(void (^completion)(NSString *)) {
+    nw_endpoint_t endpoint=nw_endpoint_create_host(TK_AUTH_PEER.UTF8String,"49152");
+    nw_parameters_t parameters=nw_parameters_create_secure_udp(NW_PARAMETERS_DISABLE_PROTOCOL,NW_PARAMETERS_DEFAULT_CONFIGURATION);
+    nw_connection_t connection=nw_connection_create(endpoint,parameters);
+    __block BOOL finished=NO;
+    void (^finish)(NSString *)=^(NSString *text) {
+        if(finished)return;
+        finished=YES;
+        nw_connection_cancel(connection);
+        completion(text);
+    };
+    nw_connection_set_queue(connection,dispatch_get_main_queue());
+    nw_connection_set_state_changed_handler(connection,^(nw_connection_state_t state,nw_error_t error) {
+        (void)error;
+        if(state!=nw_connection_state_ready && state!=nw_connection_state_waiting && state!=nw_connection_state_failed)return;
+        nw_path_t path=nw_connection_copy_current_path(connection);
+        if(!path) {finish(@"Tunnel path: none.");return;}
+        NSMutableArray<NSString *> *interfaces=[NSMutableArray new];
+        nw_path_enumerate_interfaces(path,^bool(nw_interface_t interface) {
+            [interfaces addObject:[NSString stringWithFormat:@"%s/%d",nw_interface_get_name(interface),(int)nw_interface_get_type(interface)]];
+            return true;
+        });
+        finish([NSString stringWithFormat:@"Tunnel path: %@ cellular=%d expensive=%d constrained=%d.",
+            interfaces.count?[interfaces componentsJoinedByString:@","]:@"no interface",
+            nw_path_uses_interface_type(path,nw_interface_type_cellular),nw_path_is_expensive(path),nw_path_is_constrained(path)]);
+    });
+    nw_connection_start(connection);
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW,2*NSEC_PER_SEC),dispatch_get_main_queue(),^{
+        finish(@"Tunnel path: not reported within 2 s.");
+    });
+}
