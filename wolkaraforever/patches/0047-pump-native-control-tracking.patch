+            AKPumpTouchEvents([self.keyWindow ak_configuringTouchControls]);
             pumpTurns++; pumpMs+=(NSProcessInfo.processInfo.systemUptime-now2)*1000.0;
             if(pumpPolls%2000==0)
                 AKLog(@"pump polls=%lu turns=%lu in_runloop_ms=%.0f (%.2f ms per poll)",
                       pumpPolls,pumpTurns,pumpMs,pumpMs/(double)pumpPolls);
         }
