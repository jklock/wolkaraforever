             @synchronized(layer) {
                 timing=objc_getAssociatedObject(layer,&timingMarker);
                 if(!timing) { timing=[AKFrameTiming new]; objc_setAssociatedObject(layer,&timingMarker,timing,OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
@@ -141,10 +224,20 @@ static id<CAMetalDrawable> observedNextDrawable(id layer, SEL selector) {
 static void markCapture(id command,id<MTLDrawable> drawable) {
     if(objc_getAssociatedObject(drawable,&captureMarker)) objc_setAssociatedObject(command,&captureTarget,drawable,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
 }
-static void observedPresent(id command,SEL selector,id<MTLDrawable> drawable) { markCapture(command,drawable); originalPresent(command,selector,drawable); }
-static void observedPresentAt(id command,SEL selector,id<MTLDrawable> drawable,CFTimeInterval time) { markCapture(command,drawable); originalPresentAt(command,selector,drawable,time); }
-static void observedPresentAfter(id command,SEL selector,id<MTLDrawable> drawable,CFTimeInterval time) { markCapture(command,drawable); originalPresentAfter(command,selector,drawable,time); }
+// Marks the buffer that presents this frame, so commit can ask for its GPU
+// interval. Only a presenting buffer is timed: a compute or blit-only commit
+// says nothing about how long the displayed frame took.
+static void notePresented(id command) {
+    if(atomic_load(&s_recordFrames)) objc_setAssociatedObject(command,&frameMarker,@YES,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+static void observedPresent(id command,SEL selector,id<MTLDrawable> drawable) { markCapture(command,drawable); notePresented(command); originalPresent(command,selector,drawable); }
+static void observedPresentAt(id command,SEL selector,id<MTLDrawable> drawable,CFTimeInterval time) { markCapture(command,drawable); notePresented(command); originalPresentAt(command,selector,drawable,time); }
+static void observedPresentAfter(id command,SEL selector,id<MTLDrawable> drawable,CFTimeInterval time) { markCapture(command,drawable); notePresented(command); originalPresentAfter(command,selector,drawable,time); }
 static void observedCommit(id<MTLCommandBuffer> command,SEL selector) {
+    if(atomic_load(&s_recordFrames) && objc_getAssociatedObject(command,&frameMarker)) {
+        objc_setAssociatedObject(command,&frameMarker,nil,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        [command addCompletedHandler:^(id<MTLCommandBuffer> completed) { AKRecordMetalFrameGPU(completed.GPUStartTime,completed.GPUEndTime); }];
+    }
     id<CAMetalDrawable> drawable=objc_getAssociatedObject(command,&captureTarget);
     if(drawable) {
         NSNumber *captureNumber=objc_getAssociatedObject(drawable,&captureMarker);
@@ -191,15 +284,21 @@ void AKInstallMetalPresentationDiagnostics(id<MTLDevice> device) {
     static dispatch_once_t once;
     dispatch_once(&once,^{
         captureFrames=sample; measureFrames=measure;
+        // --measure-native wants the same per-frame statistics the HUD asks for,
+        // so it turns the gate on itself rather than relying on a HUD nobody opened.
+        if(measure) atomic_store(&s_recordFrames,true);
         originalNextDrawable=(void *)replace(CAMetalLayer.class,@selector(nextDrawable),(IMP)observedNextDrawable);
-        // Timing observes presentation timestamps only. It never enables GPU
-        // readback or changes framebuffer flags, even on authentication screens.
