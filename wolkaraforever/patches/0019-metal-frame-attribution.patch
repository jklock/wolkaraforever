# WolkaraForever layer patch 0019 - Metal: GPU time per presented frame
#
# Why: the performance HUD can report a frame rate and a frame interval, and both
# are true whether the GPU is the limit or the CPU is. Deciding which - and so
# whether a performance lane is worth any work at all - needs the GPU's own
# execution time for the frame that was displayed. Metal reports it after the
# fact on the command buffer (gpuStartTime, gpuEndTime), so the adapter records
# the interval of the buffer that presented each frame and publishes it, plus the
# share of wall time the GPU was busy over a trailing second.
#
# What it does: hooks presentDrawable:/presentDrawable:atTime:/
# presentDrawable:afterMinimumDuration: and commit to mark and then time the
# presenting buffer. It reads no guest memory, changes no drawable flag, never
# captures a frame, and allocates nothing per frame unless frame statistics were
# asked for (AKEnableMetalFrameStatistics, which the HUD calls, or
# --measure-native). With them off the hooks are one atomic load each.
#
# It also records how long the client blocked asking for a drawable (wait_ms):
# with the GPU time that splits a late frame into 'the client had not asked the
# GPU yet' and 'the display or present queue held it back'.
#
# The frame-timing summary is written whenever the numbers are being collected -
# the HUD switched on by name, or --measure-native - so a session can be read
# from the guest log afterwards instead of photographed. The line carries
# gpu_ms, gpu_load, wait_ms and the thermal state.
#
# Applies to: translation/Metal/Presentation.m
# Upstream: candidate (not submitted).
#
diff --git a/translation/Metal/Presentation.m b/translation/Metal/Presentation.m
index 5254185..55a702e 100644
--- a/translation/Metal/Presentation.m
+++ b/translation/Metal/Presentation.m
@@ -62,6 +62,71 @@ __attribute__((visibility("default"))) double AKMetalLastFrameTimeMs(void) {
     return ms;
 }
 
+// How much of the frame the GPU was actually busy for.
+//
+// The frame interval alone cannot say whether a slow frame is the GPU or the
+// CPU: a 16.7 ms frame is "fine" whether the GPU took 16 ms of it or 6 ms with
+// 10 ms of drawing-code time in front. Metal reports both ends of the GPU's own
+// execution on a completed command buffer (gpuStartTime, gpuEndTime), so the
+// adapter records the interval of the buffer that presented the frame and the
+// sum of those intervals over a trailing second. GPU time close to the frame
+// interval means the GPU is the limit; far below it means the CPU is.
+static double s_lastGPUTimeMs = 0.0;
+static double s_gpuBusy = 0.0;
+static double s_gpuWindowStart = 0.0;
+static double s_gpuLoad = 0.0;
+
+void AKRecordMetalFrameGPU(double gpuStart, double gpuEnd) {
+    if (!(gpuStart > 0.0) || !(gpuEnd > gpuStart)) return;
+    os_unfair_lock_lock(&s_fpsLock);
+    s_lastGPUTimeMs = (gpuEnd - gpuStart) * 1000.0;
+    if (s_gpuWindowStart <= 0.0 || gpuEnd < s_gpuWindowStart) s_gpuWindowStart = gpuEnd;
+    s_gpuBusy += gpuEnd - gpuStart;
+    double span = gpuEnd - s_gpuWindowStart;
+    if (span >= 1.0) {
+        s_gpuLoad = s_gpuBusy / span;
+        s_gpuBusy = 0.0;
+        s_gpuWindowStart = gpuEnd;
+    }
+    os_unfair_lock_unlock(&s_fpsLock);
+}
+
+__attribute__((visibility("default"))) double AKMetalLastGPUTimeMs(void) {
+    os_unfair_lock_lock(&s_fpsLock);
+    double ms = s_lastGPUTimeMs;
+    os_unfair_lock_unlock(&s_fpsLock);
+    return ms;
+}
+__attribute__((visibility("default"))) double AKMetalGPULoad(void) {
+    os_unfair_lock_lock(&s_fpsLock);
+    double load = s_gpuLoad;
+    os_unfair_lock_unlock(&s_fpsLock);
+    return load;
+}
+
+// How long the client waited for a drawable.
+//
+// This separates the two ways a frame can be late when the GPU is not the
+// limit. A drawable request that blocks means the display or the present queue
+// is holding the frame back; a request that returns at once means the client
+// still had work to do and had not asked the GPU yet. Same 20 ms frame, two
+// different owners.
+static double s_lastDrawableWaitMs = 0.0;
+
+void AKRecordMetalDrawableWait(double seconds) {
+    if (!(seconds >= 0.0)) return;
+    os_unfair_lock_lock(&s_fpsLock);
+    s_lastDrawableWaitMs = seconds * 1000.0;
+    os_unfair_lock_unlock(&s_fpsLock);
+}
+
+__attribute__((visibility("default"))) double AKMetalLastDrawableWaitMs(void) {
+    os_unfair_lock_lock(&s_fpsLock);
+    double ms = s_lastDrawableWaitMs;
+    os_unfair_lock_unlock(&s_fpsLock);
+    return ms;
+}
+
 // Recording is off until something asks for it.
 //
 // The presented handler below allocates a block and takes a lock on every single frame. That
@@ -81,6 +146,8 @@ static void (*originalCommit)(id,SEL);
 static atomic_uint_fast64_t obtained, presented;
