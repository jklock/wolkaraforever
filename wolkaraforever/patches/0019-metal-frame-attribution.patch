-            AKLog(@"frame timing seconds=%.2f fps=%.1f max_gap_ms=%.1f gaps_over_50ms=%lu",elapsed,_frames/elapsed,_longest*1000,(unsigned long)_slow);
+            AKLog(@"frame timing seconds=%.2f fps=%.1f max_gap_ms=%.1f gaps_over_50ms=%lu gpu_ms=%.1f gpu_load=%.2f wait_ms=%.2f thermal=%d",elapsed,_frames/elapsed,_longest*1000,(unsigned long)_slow,AKMetalLastGPUTimeMs(),AKMetalGPULoad(),AKMetalLastDrawableWaitMs(),(int)NSProcessInfo.processInfo.thermalState);
             _start=time; _frames=0; _slow=0; _longest=0;
         }
     }
@@ -108,7 +175,19 @@ extern NSArray *AKRenderStatsForCommand(id command);
 static id<CAMetalDrawable> observedNextDrawable(id layer, SEL selector) {
     // A framebuffer-only drawable cannot be copied for diagnostic readback.
     if(captureFrames) ((CAMetalLayer *)layer).framebufferOnly=NO;
+    // How many drawables the layer hands out decides how far the client may run
+    // ahead: with one, every frame waits for the previous one to be presented,
+    // which looks like a frame that is too slow while the GPU sits idle. Record
+    // it once per layer so a run can say which is gating.
+    if(!objc_getAssociatedObject(layer,&poolLogged)) {
+        objc_setAssociatedObject(layer,&poolLogged,@YES,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        CAMetalLayer *metal=(CAMetalLayer *)layer;
+        AKLog(@"Metal drawable pool: maximumDrawableCount=%lu allowsNextDrawableTimeout=%d",(unsigned long)metal.maximumDrawableCount,metal.allowsNextDrawableTimeout);
+    }
+    BOOL timing_wanted=atomic_load(&s_recordFrames) || measureFrames;
+    double requestedAt=timing_wanted?CACurrentMediaTime():0.0;
     id<CAMetalDrawable> drawable=originalNextDrawable(layer,selector);
+    if(requestedAt>0.0) AKRecordMetalDrawableWait(CACurrentMediaTime()-requestedAt);
     // Nothing wanted: hand the drawable straight back. A normal run took this path
     // before the HUD existed and takes it again whenever the HUD is off.
     if(!drawable || (!atomic_load(&s_recordFrames) && !captureFrames && !measureFrames)) return drawable;
@@ -117,7 +196,11 @@ static id<CAMetalDrawable> observedNextDrawable(id layer, SEL selector) {
         if(count==1 || count==60 || count==600 || count==1800) AKLog(@"Metal drawable %llu acquired: %lux%lu format=%lu",(unsigned long long)count,(unsigned long)drawable.texture.width,(unsigned long)drawable.texture.height,(unsigned long)drawable.texture.pixelFormat);
         if(captureFrames && (count==60 || count==600 || count==1800)) { objc_setAssociatedObject(drawable,&captureMarker,@(count),OBJC_ASSOCIATION_RETAIN_NONATOMIC); CGRect r=((CALayer *)layer).frame; AKLog(@"drawable layer=%p super=%p frame=(%g,%g,%g,%g) hidden=%d",layer,((CALayer *)layer).superlayer,r.origin.x,r.origin.y,r.size.width,r.size.height,((CALayer *)layer).hidden); }
         AKFrameTiming *timing=nil;
-        if(measureFrames) {
+        if(measureFrames || atomic_load(&s_recordFrames)) {
+            // The HUD asks for these numbers by name, so when it is on they are
+            // the ones worth writing down; --measure-native is simply another way
+            // to ask. Either way the summary goes to the log, so a session can be
