 @implementation AKFrameTiming
+- (void)recordSubmission:(double)seconds {
+    @synchronized(self) {
+        _cpuSubmissionTotal += seconds;
+        _cpuSubmissionMax = MAX(_cpuSubmissionMax, seconds);
+        _cpuSubmissionSamples++;
+    }
+}
+- (void)recordCompletedWait:(double)seconds { @synchronized(self) { _completedWaits++; _completedWaitTotal += seconds; _completedWaitMax = MAX(_completedWaitMax, seconds); } }
+- (void)recordScheduledWait:(double)seconds { @synchronized(self) { _scheduledWaits++; _scheduledWaitTotal += seconds; _scheduledWaitMax = MAX(_scheduledWaitMax, seconds); } }
