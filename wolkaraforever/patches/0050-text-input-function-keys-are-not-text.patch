# WolkaraForever layer patch 0050 - text input: a function key is never text
#
# Why: AKInterpretTextKey inserted the characters AppKit reserves for function keys as text
# whenever no command named the key: F12 (U+F70F), F1-F35, Insert, Help... AppKit never
# does. Found on 2026-11-05 while looking into a refused WoW Forever login on the iPhone Duo,
# because the mobile keyboard sends F12 (the Interface mobile add-on's "open the chat input"
# binding) in front of a chat line. That refusal had another cause: the device log showed
# WoW does not hand F12 to interpretKeyEvents, and the same login was refused without F12
# and accepted later with the same input. Any guest that does would have had an invisible
# character in its focused field. The characters from U+F700 (NSUpArrowFunctionKey) to
# U+F747 (NSModeSwitchFunctionKey) are no longer inserted, and the adapter logs once per key,
# without any typed text, that it inserted nothing. The Apple logo (U+F8FF) shares the
# private-use block and is still typed; keys that are commands (arrows, Home, End, Page
# Up/Down, Forward Delete) are unchanged. tests/test_text_input.m fails without this patch.
#
# Applies to: translation/AppKit/TextInput.m
#             tests/test_text_input.m
# Upstream: candidate.
#
--- a/translation/AppKit/TextInput.m
+++ b/translation/AppKit/TextInput.m
@@ -73,6 +73,21 @@
         return;
     }
     if(!characters.length || command || control) return;
+    // AppKit never makes text of a function key. The characters it reserves for them,
+    // NSUpArrowFunctionKey (U+F700) to NSModeSwitchFunctionKey (U+F747) - F1 to F35,
+    // Insert, Print Screen, Help... - are not inserted when no binding names the key.
+    // Inserted, F12's U+F70F is an invisible character in front of whatever follows it
+    // in the focused field, a password field included. The Apple logo (U+F8FF) shares
+    // the private-use block and is a character.
+    unichar first=[characters characterAtIndex:0];
+    if(first>=0xF700 && first<=0xF747) {
+        static uint64_t reported[2];
+        if(keyCode<128 && !(reported[keyCode/64]&(1ULL<<(keyCode%64)))) {
+            reported[keyCode/64]|=1ULL<<(keyCode%64);
+            AKLog(@"text: function key %u (U+%04X) is not text; nothing inserted",(unsigned)keyCode,(unsigned)first);
+        }
+        return;
+    }
     SEL insert=NSSelectorFromString(@"insertText:replacementRange:");
     if([client respondsToSelector:insert]) ((void (*)(id,SEL,id,NSRange))[client methodForSelector:insert])(client,insert,characters,NSMakeRange(NSNotFound,0));
     else {
--- a/tests/test_text_input.m
+++ b/tests/test_text_input.m
@@ -1,5 +1,14 @@
