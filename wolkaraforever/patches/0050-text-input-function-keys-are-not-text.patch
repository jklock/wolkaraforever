+    va_list ap; va_start(ap, fmt);
+    NSString *line = [[NSString alloc] initWithFormat:fmt arguments:ap];
+    va_end(ap);
+    [logged addObject:line];
+}
 @interface InputClient : NSObject
 @property(copy) NSString *text, *command;
 @property NSRange range;
@@ -9,8 +18,9 @@
 - (void)doCommandBySelector:(SEL)selector { self.command=NSStringFromSelector(selector); }
 @end
 int main(void) { @autoreleasepool {
+    logged = [NSMutableArray new];
     NSMutableArray<NSDictionary *> *keys = [NSMutableArray new];
-    AKEnumerateTextKeys(@"aA@ñ🙂e\u0301\r\n\t", ^(NSString *text, NSString *plain, unsigned short code, NSUInteger mods) {
+    AKEnumerateTextKeys(@"aA@ñ🙂é\r\n\t", ^(NSString *text, NSString *plain, unsigned short code, NSUInteger mods) {
         [keys addObject:@{@"text":text, @"plain":plain, @"code":@(code), @"mods":@(mods)}];
     });
     assert(keys.count == 8);
@@ -18,7 +28,7 @@
     assert([keys[1][@"code"] intValue] == 0 && [keys[1][@"plain"] isEqual:@"a"] && [keys[1][@"mods"] unsignedLongValue] == (1UL << 17));
     assert([keys[2][@"code"] intValue] == 19 && [keys[2][@"plain"] isEqual:@"2"] && [keys[2][@"text"] isEqual:@"@"]);
     for (unsigned i = 3; i <= 5; i++) assert([keys[i][@"code"] intValue] == 0xFF);
-    assert([keys[4][@"text"] isEqual:@"🙂"] && [keys[5][@"text"] isEqual:@"e\u0301"]);
+    assert([keys[4][@"text"] isEqual:@"🙂"] && [keys[5][@"text"] isEqual:@"é"]);
     assert([keys[6][@"code"] intValue] == 36 && [keys[6][@"text"] isEqual:@"\r"]);
     assert([keys[7][@"code"] intValue] == 48);
     AKEnumerateTextKeys(@"", ^(NSString *text, NSString *plain, unsigned short code, NSUInteger mods) {
@@ -31,5 +41,22 @@
     AKInterpretTextKey(client,@"",123,(1UL<<17)|(1UL<<19));assert([client.command isEqual:@"moveWordLeftAndModifySelection:"]);
     AKInterpretTextKey(client,@"",51,0);assert([client.command isEqual:@"deleteBackward:"]);
     AKInterpretTextKey(client,@"password text must not be logged",0,0);assert([client.text hasPrefix:@"password"]);
-    puts("software text keys, composed Unicode, text-client ABI, commands and replacement ranges: PASS");
+    // A function key is never text, as in AppKit. F12's U+F70F once went into a login
+    // screen's password field in front of the password. Nothing is inserted, no command
+    // is sent, and the log says so once per key without any typed text.
+    client.text=@"typed";client.command=nil;
+    AKInterpretTextKey(client,@"",111,0);assert([client.text isEqual:@"typed"] && client.command==nil);
+    AKInterpretTextKey(client,@"",111,1UL<<17);assert([client.text isEqual:@"typed"] && client.command==nil);
+    AKInterpretTextKey(client,@"",122,0);assert([client.text isEqual:@"typed"] && client.command==nil);
+    AKInterpretTextKey(client,@"",114,0);assert([client.text isEqual:@"typed"] && client.command==nil);
+    assert(logged.count==3);
+    assert([logged[0] rangeOfString:@"111"].location!=NSNotFound);
+    for (NSString *line in logged) assert([line rangeOfString:@"password"].location==NSNotFound && [line rangeOfString:@"typed"].location==NSNotFound);
+    // The Apple logo (Option-Shift-K) shares the private-use block and is a character.
+    AKInterpretTextKey(client,@"",40,(1UL<<17)|(1UL<<19));assert([client.text isEqual:@""]);
+    // Keys that are commands carry function-key characters too; they stay commands.
+    AKInterpretTextKey(client,@"",123,0);assert([client.command isEqual:@"moveLeft:"]);
+    AKInterpretTextKey(client,@"",115,0);assert([client.command isEqual:@"moveToBeginningOfDocument:"]);
+    assert(logged.count==3);
+    puts("software text keys, composed Unicode, text-client ABI, commands, replacement ranges and function keys: PASS");
 } }
