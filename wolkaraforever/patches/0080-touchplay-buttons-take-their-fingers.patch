+// One key with modifiers, pressed or released - a TouchPlay button's CTRL-ALT-SHIFT key. Each modifier
+// the key needs and is not already held goes down first, as its own key (a flags-changed event with its
+// key code and left-hand device bit, as a Mac keyboard reports it); then the key; then those modifiers
+// come up again, in reverse. So nothing stays held between two touch keys, and a click or a typed key in
+// between carries only what the user is really holding. TouchPlay acts on the up click, so the caller
+// sends a down and an up for each tap.
+- (void)touchKey:(unsigned short)code characters:(NSString *)characters modifiers:(NSUInteger)modifiers pressed:(BOOL)pressed {
+    static const struct { UIKeyboardHIDUsage usage; NSEventModifierFlags flag; } chord[] = {
+        {0xE0, NSEventModifierFlagControl}, {0xE2, NSEventModifierFlagOption}, {0xE1, NSEventModifierFlagShift},
+    };
+    UIKeyboardHIDUsage added[3]; size_t count = 0;
+    for (size_t i = 0; i < 3; i++) {
+        if (!(modifiers & chord[i].flag) || (_mods & chord[i].flag)) continue;
+        _mods = AKModifiersAfterKey(_mods, chord[i].usage, YES);
+        [self postTouchModifier:chord[i].usage];
+        added[count++] = chord[i].usage;
+    }
+    NSEvent *event = [NSEvent new];
+    event.type = pressed ? NSEventTypeKeyDown : NSEventTypeKeyUp;
+    event.window = self.nsWindow; event.keyCode = code; event.modifierFlags = _mods;
     event.characters = characters; event.charactersIgnoringModifiers = characters;
+    event.timestamp = NSProcessInfo.processInfo.systemUptime;
+    [NSApp postEvent:event atStart:NO];
+    while (count > 0) {
+        UIKeyboardHIDUsage usage = added[--count];
+        _mods = AKModifiersAfterKey(_mods, usage, NO);
+        [self postTouchModifier:usage];
+    }
+}
+- (void)postTouchModifier:(UIKeyboardHIDUsage)usage {
+    NSEvent *event = [NSEvent new];
+    event.type = NSEventTypeFlagsChanged; event.window = self.nsWindow;
+    event.keyCode = AKKeyCode(usage); event.modifierFlags = _mods;
     event.timestamp = NSProcessInfo.processInfo.systemUptime;
     [NSApp postEvent:event atStart:NO];
+}
