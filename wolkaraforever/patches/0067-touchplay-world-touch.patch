+// A spell dragged off its TouchPlay button is aimed by the finger (TouchAreas.m): the pointer goes where
+// the finger is, with no button down, so the game's circle is under it; the lift on the world is a
+// left click there, which places the spell.
+// The pointer is shared: if another finger is dragging the view (a button is down), the aim ends that
+// drag first, as a pinch does - its button comes up and the rest of that gesture posts nothing - so the
+// aim never moves or clicks with the drag's button still down (left + right is the game's run).
+- (void)touchPointerAt:(CGPoint)p click:(BOOL)click {
+    if (_pressedLeft || _pressedRight) {
+        if ([self directGestureActive]) [self beginDirectMulti];
+        else {
+            if (_pressedLeft) [self postMouse:NSEventTypeLeftMouseUp at:_last button:0];
+            if (_pressedRight) [self postMouse:NSEventTypeRightMouseUp at:_last button:1];
+        }
+    }
+    if (!CGPointEqualToPoint(p, _last) || !click) [self postMouse:NSEventTypeMouseMoved at:p button:0];
+    if (!click) return;
+    [self postMouse:NSEventTypeLeftMouseDown at:p button:0];
+    [self postMouse:NSEventTypeLeftMouseUp at:p button:0];
+}
