+// TouchPlay: whether a tap at `p` is the second of two world taps, close by and soon (the record is
+// then gone); otherwise it is the first, and is remembered. The time is the areas' clock.
+- (BOOL)worldSecondTapAt:(CGPoint)p {
+    if (!_touchAreas.contract) return NO;
+    NSTimeInterval now = _touchAreas.clock();
+    if (_worldTapRecorded && now - _worldTapTime <= AKDirectSecondTapWindow &&
+        hypot(p.x - _worldTapPoint.x, p.y - _worldTapPoint.y) <= AKDirectSecondTapRadius) {
+        _worldTapRecorded = NO;
+        return YES;
+    }
+    _worldTapRecorded = YES; _worldTapPoint = p; _worldTapTime = now;
+    return NO;
+}
+- (BOOL)pointInEdgeZone:(CGPoint)p { return !CGRectContainsPoint(CGRectInset(self.bounds, AKDirectEdgeInset, AKDirectEdgeInset), p); }
+// TouchPlay: a finger that lands in the edge zone is held quietly by the areas until it lifts, so none of
+// its moves or its lift reach the gestures below either; the others go on.
+- (NSSet<UITouch *> *)touchesOutsideEdgeZone:(NSSet<UITouch *> *)t {
+    NSMutableSet<UITouch *> *rest = [NSMutableSet setWithCapacity:t.count];
+    for (UITouch *touch in t) {
+        if (touch.type == UITouchTypeDirect && [self pointInEdgeZone:[touch locationInView:self]]) [_touchAreas keepQuiet:touch];
+        else [rest addObject:touch];
+    }
+    return rest;
+}
