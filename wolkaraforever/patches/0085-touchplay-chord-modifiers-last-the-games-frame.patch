-// the key needs and is not already held goes down first, as its own key (a flags-changed event with its
-// key code and left-hand device bit, as a Mac keyboard reports it); then the key; then those modifiers
-// come up again, in reverse. So nothing stays held between two touch keys, and a click or a typed key in
-// between carries only what the user is really holding. TouchPlay acts on the up click, so the caller
-// sends a down and an up for each tap.
+// the key needs and nobody holds yet goes down first, as its own key (a flags-changed event with its key
+// code and left-hand device bit, as a Mac keyboard reports it); then the key. The modifiers stay down
+// until the guest has had the key for a frame or more (patch 0085): the game reads them when it acts on
+// the key, in its frame, so modifiers released in the same batch as the key left it bare - the an iPad test
+// bug (H opened the PvP panel instead of a spell). A tap's down and up share one press of them, and a
+// chord key while they are down only keeps them down longer. Meanwhile every other input - a click, a
+// walk key, a typed key - waits for them to come up (ak_chordTakesEvent:), so it never carries the chord.
+// A key without modifiers (the walk stick's W/A/S/D) is such other input. TouchPlay acts on the up click,
+// so the caller sends a down and an up for each tap.
+static NSEventModifierFlags AKChordFlag(UIKeyboardHIDUsage usage) {
+    return usage == 0xE0 ? NSEventModifierFlagControl : usage == 0xE2 ? NSEventModifierFlagOption : usage == 0xE1 ? NSEventModifierFlagShift : 0;
+}
+// `flags` without one modifier key the chord holds: its device bit, and its flag unless the other side's key is down.
+static NSEventModifierFlags AKFlagsWithoutKey(NSEventModifierFlags flags, UIKeyboardHIDUsage usage) {
+    for (size_t i = 0; i < sizeof AKModifierKeys / sizeof *AKModifierKeys; i++) {
+        if (AKModifierKeys[i].usage != usage) continue;
+        flags &= ~AKModifierKeys[i].bit;
+        if (!(flags & AKModifierKeys[i ^ 1].bit)) flags &= ~AKModifierKeys[i].flag;   // left and right are neighbours
+    }
+    return flags;
+}
