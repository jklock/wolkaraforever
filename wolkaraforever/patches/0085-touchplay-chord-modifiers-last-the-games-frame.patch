+}
+// The queue's question while a chord is held (0085): an event the host did not post as part of the chord
+// carries only what the user holds, and waits for the chord to come up - all of it from the first one on,
+// so the guest still gets the host's input in the order it was made. A pointer move with nothing waiting
+// goes at once, so an aimed spell's circle keeps up with the finger.
+- (BOOL)ak_chordTakesEvent:(NSEvent *)event {
+    if (!_chordCount || _chordPosting) return NO;
+    NSEventModifierFlags flags = event.modifierFlags;
+    for (size_t i = 0; i < _chordCount; i++) flags = AKFlagsWithoutKey(flags, _chordUsages[i]);
+    event.modifierFlags = flags;
+    NSEventType type = event.type;
+    BOOL motion = type == NSEventTypeMouseMoved || type == NSEventTypeLeftMouseDragged ||
+                  type == NSEventTypeRightMouseDragged || type == NSEventTypeOtherMouseDragged;
+    if (motion && !_chordWaiting.count) return NO;
+    if (!_chordWaiting) _chordWaiting = [NSMutableArray array];
+    [_chordWaiting addObject:event];
+    return YES;
+}
+// The guest asked for an event and the queue had none: it has taken everything posted so far. Enough of
+// those, and long enough after the chord's last key, its frame has gone by: the modifiers come up, in
+// reverse, and whatever waited follows them.
+- (void)ak_guestFoundQueueEmpty {
+    if (!_chordCount) return;
+    if (++_chordEmptyPolls < AKTouchChordReleasePolls) return;
+    NSTimeInterval held = NSProcessInfo.processInfo.systemUptime - _chordKeyTime;
+    if (held < AKTouchChordReleaseSeconds) return;
+    unsigned polls = _chordEmptyPolls;
+    _chordPosting = YES;
+    while (_chordCount) {
+        UIKeyboardHIDUsage usage = _chordUsages[--_chordCount];
         _mods = AKModifiersAfterKey(_mods, usage, NO);
         [self postTouchModifier:usage];
     }
+    _chordPosting = NO;
+    if (AKChordHost == self) AKChordHost = nil;
+    NSArray<NSEvent *> *waiting = _chordWaiting;
+    _chordWaiting = nil;
+    static unsigned logged;
+    if (logged < 8) {
+        logged++;
+        AKLog(@"touch chord: its modifiers came up after %u empty polls and %.0f ms; %lu other events waited",
+              polls, held * 1000, (unsigned long)waiting.count);
+    }
+    for (NSEvent *event in waiting) [NSApp postEvent:event atStart:NO];
 }
