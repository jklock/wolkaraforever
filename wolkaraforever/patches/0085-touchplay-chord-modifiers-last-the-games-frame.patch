+// dequeued (an iPad test, 16 Nov), so a chord released in the same batch as its key reached it bare.
+static const unsigned AKTouchChordReleasePolls = 3;
+static const NSTimeInterval AKTouchChordReleaseSeconds = 0.05;
 
