+    static const UIKeyboardHIDUsage chord[] = {0xE0, 0xE2, 0xE1};   // control, option, shift - pressed in this order
+    NSEventModifierFlags wanted = modifiers & (NSEventModifierFlagControl | NSEventModifierFlagOption | NSEventModifierFlagShift);
