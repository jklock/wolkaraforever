 - (void)setLayer:(CALayer *)l {
+    if (_layer == l) return;
+    CALayer *old = _layer;
+    CALayer *parent = old.superlayer;
+    [l removeFromSuperlayer];
+    NSUInteger index = [parent.sublayers indexOfObjectIdenticalTo:old];
+    if (!l && parent) { _detachedLayerParent = parent; _detachedLayerIndex = index; }
+    if (l && !parent && _detachedLayerParent &&
+        (_detachedLayerParent == _superview.layer ||
+         (self == self.window.contentView && _detachedLayerParent == [self.window ak_hostLayer]))) {
+        parent = _detachedLayerParent;
+        index = _detachedLayerIndex;
+    }
+    if (l) _detachedLayerParent = nil;
+    if (!parent && _superview) {
+        parent = _superview.layer;
+        NSUInteger sibling = [_superview->_subviews indexOfObjectIdenticalTo:self];
+        index = 0;
+        for (NSUInteger i = 0; i < sibling; i++)
+            if (_superview->_subviews[i].layer.superlayer == parent) index++;
+    } else if (!parent && self == self.window.contentView) {
+        parent = [self.window ak_hostLayer];
+        index = parent.sublayers.count;
+    }
+    BOOL hosted = l && old.superlayer && [self.window ak_hostLayer];
+    if (hosted) AKLog(@"view layer replaced on screen: %@ -> %@ (main thread=%d)", NSStringFromClass(old.class), NSStringFromClass(l.class), NSThread.isMainThread);
+    [old removeFromSuperlayer];
     _layer = l;
     // As AppKit's: a view's layer is placed by its origin, which Wine's Mac driver sets as the position.
     l.anchorPoint = CGPointZero;
     l.frame = _frame; l.delegate = nil; l.hidden=_hidden;
+    if (l) {
+        for (NSView *child in _subviews) if (child.layer) [l addSublayer:child.layer];
+        if (self == self.window.contentView) [self.window ak_applyContentScaleToLayer:l];
+        if (parent) [parent insertSublayer:l atIndex:(unsigned)MIN(index, parent.sublayers.count)];
+    }
 }
