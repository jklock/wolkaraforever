# WolkaraForever layer patch 0012 - AppKit: show what the game actually receives
#
# Why: the platform logs only the first 16 key deliveries, which cannot show
# whether a controller press reaches the game as a keystroke. With the
# inspector's launch argument set, every delivery is logged with its key code,
# characters and modifiers, so the two ends of the input path can be compared.
# Off by default: a normal launch keeps the original behaviour and cost.
#
# Applies to: translation/AppKit/AppKit.m
# Upstream: not for submission. Diagnostic for our own controller work.
#
diff --git a/translation/AppKit/AppKit.m b/translation/AppKit/AppKit.m
--- a/translation/AppKit/AppKit.m
+++ b/translation/AppKit/AppKit.m
@@ -994,7 +994,10 @@
                     if(e.type==NSEventTypeKeyDown || e.type==NSEventTypeKeyUp) {
                         double age=NSProcessInfo.processInfo.systemUptime-e.timestamp;
                         static unsigned loggedDelivery;
-                        if(loggedDelivery<16) { loggedDelivery++; AKLog(@"keyboard dequeued type=%lu age_ms=%.1f pending=%lu",(unsigned long)e.type,age*1000,(unsigned long)_queue.count); }
+                        static BOOL trace; static dispatch_once_t traceOnce;
+                        dispatch_once(&traceOnce, ^{ trace=[NSProcessInfo.processInfo.arguments containsObject:@"--inspect-controller"]; });
+                        if(!trace && loggedDelivery<16) { loggedDelivery++; AKLog(@"keyboard dequeued type=%lu age_ms=%.1f pending=%lu",(unsigned long)e.type,age*1000,(unsigned long)_queue.count); }
+                        else if(trace) AKLog(@"guest input type=%lu keyCode=%u chars=%@ unmodified=%@ mods=%lu age_ms=%.1f pending=%lu",(unsigned long)e.type,(unsigned)e.keyCode,e.characters ?: @"",e.charactersIgnoringModifiers ?: @"",(unsigned long)e.modifierFlags,age*1000,(unsigned long)_queue.count);
                     }
                 }
                 return e;
