+// Patch 0065 (WolkaraForever): the game's sound without iOS's HAL (AKAudioModel.h says why). The switch is read once,
+// at the game's first sound call, and said in the log.
+static BOOL avoidHAL(void) {
+    BOOL avoid=AKAudioAvoidHAL();
+    static dispatch_once_t once;
+    dispatch_once(&once,^{
+        if(avoid)AKLogC("audio: HAL model answers the game (one output device, the session's route); iOS's HAL is not called");
+        else AKLogC("audio: HAL in use (WolkaraForeverAudioAvoidHAL is off)");
+    });
+    return avoid;
+}
