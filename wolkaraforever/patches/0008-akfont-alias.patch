# WolkaraForever layer patch 0008 - AppKit: alias the adapter own NSFont to NSFont
#
# Why: the adapter implements NSFont as AKFont, and a guest asking for NSFont must
# reach it rather than UIKit private UIFoundation class of the same name, which is a
# different shape and took a launch down. Aliasing needs AKFont to be in the link: the
# adapter directory is compiled whole, so it is.
# Applies to: translation/AppKit/ldflags
# Upstream: candidate (not submitted).
#
diff --git a/translation/AppKit/ldflags b/translation/AppKit/ldflags
index 8350867..f2eca88 100644
--- a/translation/AppKit/ldflags
+++ b/translation/AppKit/ldflags
@@ -1 +1 @@
--framework UIKit -framework QuartzCore -framework CoreGraphics -framework GameController -Wl,-alias,_OBJC_CLASS_$_AKColor,_OBJC_CLASS_$_NSColor -Wl,-alias,_OBJC_METACLASS_$_AKColor,_OBJC_METACLASS_$_NSColor
+-framework UIKit -framework QuartzCore -framework CoreGraphics -framework GameController -Wl,-alias,_OBJC_CLASS_$_AKColor,_OBJC_CLASS_$_NSColor -Wl,-alias,_OBJC_METACLASS_$_AKColor,_OBJC_METACLASS_$_NSColor -Wl,-alias,_OBJC_CLASS_$_AKFont,_OBJC_CLASS_$_NSFont -Wl,-alias,_OBJC_METACLASS_$_AKFont,_OBJC_METACLASS_$_NSFont
