+def flavor(source):
+    """The product flavor this installation is, e.g. 'wowf', or None."""
+    try: lines=[line.strip() for line in (source/EDITION/'.flavor.info').read_text().splitlines() if line.strip()]
+    except OSError: return None
+    return lines[-1] if len(lines)>1 else None
+
+
+def data_folders(source):
+    """The `Data` folders to copy: the shared store and this product's own index
+    folder. Another product's index folder (a beta left behind, say) is not
+    copied: the app's store belongs to the build that is being installed."""
+    data=source/'Data'; own=flavor(source)
+    wanted=list(SHARED_DATA)+([own] if own else [])
+    return [data/name for name in wanted if (data/name).is_dir()]
+
