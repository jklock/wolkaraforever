 // it was, a tap or hold still waiting never fires, and the rest of that finger's gesture posts nothing - the
 // same "let go, then quiet until it lifts" as a pinch beginning (beginDirectMulti). With no finger of the gesture
 // down there is nothing to wait for, so the whole state is cleared outright - the multi-finger mode of a pinch too,
-// or its fingers, never lifted by the system, would swallow the first tap on return.
-- (void)touchReleaseWorldGesture {
+// or its fingers, never lifted by the system, would swallow the first tap on return. On background, iOS may never
+// report their lifts after a screen lock: forget the gesture but ignore those fingers if they send events later.
+- (void)touchReleaseWorldGestureForBackground:(BOOL)background {
     BOOL down = _directTouch && _directTouch.phase != UITouchPhaseEnded && _directTouch.phase != UITouchPhaseCancelled;
-    if (down) [self beginDirectMulti];
+    if (down && !background) [self beginDirectMulti];
     else {
+        if (background) {
+            if (!_directIgnored) _directIgnored = [NSHashTable weakObjectsHashTable];
+            for (UITouch *touch in _directFingers) [_directIgnored addObject:touch];
+            [_directFingers removeAllObjects];
+        }
         [self cancelDirectHold];
         _directPending = NO; _directHeld = NO; _directMulti = NO; _directTouch = nil; _worldTapRecorded = NO;
     }
