     // pinch, and the pinch's zoom bookkeeping.
     UITouch *_directTouch;
+    NSHashTable<UITouch *> *_directFingers; // Weakly tracks every finger in the direct gesture.
+    NSHashTable<UITouch *> *_directIgnored; // Fingers forgotten on background, until their lifts arrive.
     BOOL _directMulti;
     CGFloat _pinchScale, _pinchCarry;
     UIPinchGestureRecognizer *_pinch;
