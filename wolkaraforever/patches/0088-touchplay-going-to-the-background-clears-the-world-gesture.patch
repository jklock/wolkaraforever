# WolkaraForever layer patch 0088 - host: background clears a world gesture whose finger never lifts
#
# Why: iOS can drop fingers held at a screen lock without sending their lifts. The old quiet-until-lift
# state then swallows later taps. Only a real background clears it; resign keeps its current behavior.
# If iOS keeps sending the old fingers, ignore their events without blocking fresh fingers or pinches.
# This method is optional on the iPad touch sink; in every other interface mode the host is unchanged.
#
# Applies after: 0087-touchplay-two-fingers-are-a-pinch.patch
# Applies to: translation/AppKit/AppKit.m
# Upstream: no (iPad touch lives in the WolkaraForever layer).
#
--- a/translation/AppKit/AppKit.m
+++ b/translation/AppKit/AppKit.m
@@ -331,6 +331,8 @@
