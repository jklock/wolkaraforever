     [self postMouse:_pressedRight ? NSEventTypeRightMouseUp : NSEventTypeLeftMouseUp at:[self usesRelativeMouse]?_last:[t.anyObject locationInView:self] button:_pressedRight];
 }
-- (void)touchesCancelled:(NSSet<UITouch *> *)t withEvent:(UIEvent *)ev { [self touchesEnded:t withEvent:ev]; }
+- (void)touchesCancelled:(NSSet<UITouch *> *)t withEvent:(UIEvent *)ev {
+    if ([self directGestureActive]) {
+        // A cancelled gesture clicks nothing; whatever it held is let go.
+        [self cancelDirectHold];
+        _directPending = NO; _directHeld = NO;
+        if (_pressedLeft) [self postMouse:NSEventTypeLeftMouseUp at:_last button:0];
+        if (_pressedRight) [self postMouse:NSEventTypeRightMouseUp at:_last button:1];
+        if ([t containsObject:_directTouch]) _directTouch = nil;
+        [self finishDirectGestureIfIdle:t event:ev];
+        return;
+    }
+    [self touchesEnded:t withEvent:ev];
+}
 
