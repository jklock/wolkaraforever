+    // undecided between a tap, a hold and a drag, whether a hold already right-clicked, and
+    // the hold's timer.
+    CGPoint _directStart;
+    BOOL _directPending, _directHeld;
+    NSTimer *_directHold;
+    // The finger the direct gesture follows, whether a second finger turned it into a
+    // pinch, and the pinch's zoom bookkeeping.
+    UITouch *_directTouch;
+    BOOL _directMulti;
+    CGFloat _pinchScale, _pinchCarry;
+    UIPinchGestureRecognizer *_pinch;
 }
