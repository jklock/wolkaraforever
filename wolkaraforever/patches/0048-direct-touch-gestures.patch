+// Direct touch, with the trackpad off. A quick tap is a left click where the finger is. A
+// finger held still for a moment is a right click there, with a tap of haptics so the hold
+// is felt; sliding after that is a right drag, which turns the character. A finger that
+// moves first is a left drag from where it came down, which is the game's camera. A second
+// finger makes it a pinch: whatever the first finger had started is let go without a
+// click, and spreading or closing the fingers zooms the camera like a mouse wheel. Nothing
+// is pressed until the gesture is known, so a tap never becomes a drag by accident. A
+// mouse, a trackpad or a pencil keeps the immediate behaviour.
+static const CGFloat AKDirectSlop = 10;
+static const NSTimeInterval AKDirectHoldDelay = 0.45;
+static const CGFloat AKPinchNotch = 0.07;
+static BOOL AKIsFinger(NSSet<UITouch *> *t) { return t.anyObject.type == UITouchTypeDirect; }
+- (void)cancelDirectHold { [_directHold invalidate]; _directHold = nil; }
+- (void)directHoldFired {
+    _directHold = nil;
+    if (!_directPending || _directMulti) return;
+    _directPending = NO; _directHeld = YES;
+    [[[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleMedium] impactOccurred];
+    [self postMouse:NSEventTypeRightMouseDown at:_directStart button:1];
+    [self postMouse:NSEventTypeRightMouseUp at:_directStart button:1];
+    AKLog(@"direct touch: hold became a right click");
+}
+// Let go of whatever one finger had started, without clicking: a pinch has begun.
+- (void)beginDirectMulti {
+    [self cancelDirectHold];
+    _directPending = NO; _directHeld = NO; _directMulti = YES;
+    if (_pressedLeft) [self postMouse:NSEventTypeLeftMouseUp at:_last button:0];
+    if (_pressedRight) [self postMouse:NSEventTypeRightMouseUp at:_last button:1];
+}
+- (void)postScrollNotch:(CGFloat)direction {
+    NSEvent *event = [NSEvent new];
+    event.type = NSEventTypeScrollWheel; event.window = self.nsWindow;
+    event.locationInWindow = self.nsWindow.ak_mouseLocation; event.modifierFlags = _mods;
+    event.deltaX = event.scrollingDeltaX = 0;
+    event.deltaY = event.scrollingDeltaY = direction;
+    event.timestamp = NSProcessInfo.processInfo.systemUptime;
+    [NSApp postEvent:event atStart:NO];
+}
+- (void)directPinch:(UIPinchGestureRecognizer *)pinch {
+    if (_touchControls.trackpadEnabled) return;
+    if (pinch.state == UIGestureRecognizerStateBegan) {
+        [self beginDirectMulti];
+        _pinchScale = pinch.scale > 0 ? pinch.scale : 1; _pinchCarry = 0;
+        // The wheel turns over what is between the fingers: the world, not a window.
+        [self postMouse:NSEventTypeMouseMoved at:[pinch locationInView:self] button:0];
+        return;
+    }
+    if (pinch.state != UIGestureRecognizerStateChanged || pinch.scale <= 0) return;
+    _pinchCarry += log(pinch.scale / _pinchScale);
+    _pinchScale = pinch.scale;
+    // Fingers apart is a wheel turned forward (closer), fingers together is back (farther).
+    while (fabs(_pinchCarry) >= AKPinchNotch) {
+        CGFloat direction = _pinchCarry > 0 ? 1 : -1;
+        _pinchCarry -= direction * AKPinchNotch;
+        [self postScrollNotch:direction];
+    }
+}
+- (BOOL)directGestureActive { return _directTouch != nil || _directMulti; }
 - (void)touchesBegan:(NSSet<UITouch *> *)t withEvent:(UIEvent *)ev {
     if ([self handleTrackpadTouches:t event:ev]) return;
-    BOOL r = AKIsRight(ev);if(r?_pressedRight:_pressedLeft)return; _last = [t.anyObject locationInView:self];
+    BOOL r = AKIsRight(ev);
+    if (!r && AKIsFinger(t) && ![self usesRelativeMouse]) {
+        if ([self directGestureActive] || t.count > 1) { [self beginDirectMulti]; return; }
+        [self reconcileModifiers:AKMods(ev.modifierFlags)];
+        _directTouch = t.anyObject;
+        _last = [_directTouch locationInView:self];
+        _directStart = _last; _directPending = YES; _directHeld = NO;
+        // The pointer moves under the finger first, so the game knows what is there before
+        // any button is pressed.
+        [self postMouse:NSEventTypeMouseMoved at:_last button:0];
+        [self cancelDirectHold];
+        __weak AKHostView *weakSelf = self;
+        _directHold = [NSTimer timerWithTimeInterval:AKDirectHoldDelay repeats:NO block:^(NSTimer *timer) {
+            (void)timer; [weakSelf directHoldFired];
+        }];
+        // The guest's own loop runs the default mode; common modes include it.
+        [NSRunLoop.mainRunLoop addTimer:_directHold forMode:NSRunLoopCommonModes];
+        return;
+    }
+    if(r?_pressedRight:_pressedLeft)return; _last = [t.anyObject locationInView:self];
     [self reconcileModifiers:AKMods(ev.modifierFlags)];
     [self postMouse:r ? NSEventTypeRightMouseDown : NSEventTypeLeftMouseDown at:_last button:r];
 }
 - (void)touchesMoved:(NSSet<UITouch *> *)t withEvent:(UIEvent *)ev {
     if ([self handleTrackpadTouches:t event:ev]) return;
     if([self usesRelativeMouse])return;
+    if ([self directGestureActive]) {
+        if (_directMulti || ![t containsObject:_directTouch]) return;
+        CGPoint point = [_directTouch locationInView:self];
+        if (_directPending || _directHeld) {
+            if (hypot(point.x - _directStart.x, point.y - _directStart.y) < AKDirectSlop) return;
+            [self cancelDirectHold];
+            BOOL turn = _directHeld;
+            _directPending = NO; _directHeld = NO;
+            [self postMouse:turn ? NSEventTypeRightMouseDown : NSEventTypeLeftMouseDown at:_directStart button:turn ? 1 : 0];
+        }
+        if (CGPointEqualToPoint(point, _last)) return;
+        [self postMouse:_pressedRight ? NSEventTypeRightMouseDragged : NSEventTypeLeftMouseDragged at:point button:_pressedRight];
+        return;
+    }
     BOOL r = _pressedRight;
     CGPoint point=[t.anyObject locationInView:self];if(CGPointEqualToPoint(point,_last))return;
     [self postMouse:r ? NSEventTypeRightMouseDragged : NSEventTypeLeftMouseDragged at:point button:r];
 }
+// The direct gesture is over once no finger of it is left on this view.
+- (void)finishDirectGestureIfIdle:(NSSet<UITouch *> *)lifted event:(UIEvent *)ev {
+    for (UITouch *touch in ev.allTouches) {
+        if (touch.view != self || [lifted containsObject:touch]) continue;
+        if (touch.phase != UITouchPhaseEnded && touch.phase != UITouchPhaseCancelled) return;
+    }
+    _directMulti = NO; _directTouch = nil;
+}
 - (void)touchesEnded:(NSSet<UITouch *> *)t withEvent:(UIEvent *)ev {
     if ([self handleTrackpadTouches:t event:ev]) return;
+    if ([self directGestureActive]) {
+        if (!_directMulti && [t containsObject:_directTouch]) {
+            [self cancelDirectHold];
+            CGPoint point = [_directTouch locationInView:self];
+            if (_directPending) {
+                _directPending = NO;
+                [self postMouse:NSEventTypeLeftMouseDown at:_directStart button:0];
+                [self postMouse:NSEventTypeLeftMouseUp at:_directStart button:0];
+            } else if (_directHeld) {
+                // A hold already clicked; lifting the finger adds nothing.
+                _directHeld = NO;
+            } else if (_pressedRight || _pressedLeft) {
+                [self postMouse:_pressedRight ? NSEventTypeRightMouseUp : NSEventTypeLeftMouseUp at:point button:_pressedRight];
+            }
+            _directTouch = nil;
+        }
+        if ([t containsObject:_directTouch]) _directTouch = nil;
+        [self finishDirectGestureIfIdle:t event:ev];
+        return;
+    }
