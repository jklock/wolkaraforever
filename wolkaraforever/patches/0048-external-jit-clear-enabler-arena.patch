# WolkaraForever layer patch 0048 - runtime: an enabler's arena is not zeroed memory
#
# Why: External JIT assumed the region a JIT enabler hands back is fresh,
# zero-filled memory. But preparing a page means writing to it: StikDebug stores
# one byte, 0x69, at the start of every page it prepares (the "$M<address>,1:69"
# packets built in its JSSupport/JSDebugSupport.swift), and the runtime then wrote
# only the pages the image has bytes for. Every page of the image's zero-fill
# therefore began with 0x69 instead of 0.
#
# What was observed (2026-11-09, iPhone Duo, iOS 27.2, External JIT: AltStore with
# a free Apple ID, StikDebug 3.2.2 running its universal.js script, World of
# Warcraft Forever 1.60.1 build 70862): every launch reached the game window and
# closed about 35 seconds later. The client's own error report was the same twelve
# times out of twelve: ERROR #132, EXC_BAD_ACCESS at 0x71 in frame 1, with 0x69 in
# the register the address was formed from. 0x71 is 0x69 + 8: a field of an object
# whose pointer the client expected to be zero-initialised and read as 0x69.
#
# With this patch the same device logs
#   [native] enabler arena cleared for 99532800 bytes; 99532800 of 1073741824 bytes kept
# writes no error report and reaches the login screen. None of the fifteen game
# starts since has written one.
#
# What it does: the image's extent is cleared through the writable view before
# the image is placed, both for the arena reserved at launch and for one
# requested later. What the image does not use is then unmapped (nc_trim). The
# launch reservation asks for up to NC_MAX_ARENA before the image's size is known
# and the enabler touches every page of it, so the unused tail was resident
# memory on the one route that has no increased memory limit. On the device
# above, with the arena ready, os_proc_available_memory() went from 5015 MB to
# 5847 MB and the process's VM map from 131,319 regions to 71,841.
#
# The new block runs only for a region that came from da_request_arena. The
# Developer service, Local signing and simulator routes do not reach it.
#
# Applies to: runtime/NativeGuest.m, runtime/NativeCodeMemory.c,
#             runtime/NativeCodeMemory.h, tests/test_native_memory.c
# Upstream: candidate.

diff --git a/runtime/NativeCodeMemory.c b/runtime/NativeCodeMemory.c
--- a/runtime/NativeCodeMemory.c
+++ b/runtime/NativeCodeMemory.c
@@ -93,6 +93,18 @@ bool nc_adopt(NativeCodeMemory *memory, void *executable, size_t size) {
                                  .size = size, .published = true};
     return true;
 }
+bool nc_trim(NativeCodeMemory *memory, size_t size) {
+    size_t page = (size_t)getpagesize();
+    if (!memory || !memory->published || memory->quarantined || !memory->executable || !memory->writable ||
+        !size || size > memory->size) { errno = EINVAL; return false; }
+    size_t kept = (size + page - 1) / page * page;
+    if (kept >= memory->size) return true;
+    size_t tail = memory->size - kept;
+    if (munmap((char *)memory->executable + kept, tail)) return false;
+    // The executable tail is gone either way: the arena ends here now.
+    memory->size = kept;
+    return vm_deallocate(mach_task_self(), (vm_address_t)memory->writable + kept, tail) == KERN_SUCCESS;
+}
 typedef struct { NCPublish function; void *context; } LegacyPublisher;
 static NCPreparation legacy_prepare(void *address, size_t size, void *opaque) {
     LegacyPublisher *publisher = opaque;
diff --git a/runtime/NativeCodeMemory.h b/runtime/NativeCodeMemory.h
--- a/runtime/NativeCodeMemory.h
+++ b/runtime/NativeCodeMemory.h
@@ -40,6 +40,10 @@ bool nc_create_managed(NativeCodeMemory *memory, size_t size, NCPrepare prepare,
                        void *context, NativeCodeMemory *quarantine);
 // Adopt a region made outside; it is ours from then.
 bool nc_adopt(NativeCodeMemory *memory, void *executable, size_t size);
+// Keep the first size bytes (rounded up to a page) of both views and unmap the
+// rest. An adopted region was sized before its user was known, and whoever
+// prepared it may have touched every page of it.
+bool nc_trim(NativeCodeMemory *memory, size_t size);
 // Caller must ensure no thread is executing the range while it is being changed.
 // Copies through RW, flushes caches, and keeps the RX protection unchanged.
 bool nc_write(NativeCodeMemory *memory, size_t offset, const void *bytes, size_t size);
diff --git a/runtime/NativeGuest.m b/runtime/NativeGuest.m
--- a/runtime/NativeGuest.m
+++ b/runtime/NativeGuest.m
@@ -1756,7 +1756,7 @@ bool ng_initialize(const char *path, const char *frameworks, const char *library
         LOG("[native] the arena reserved earlier (%zu bytes) is not used; given back\n",reserved_arena.size);
         nc_destroy(&reserved_arena);
     }
-    bool take_reserved=reserved==NG_RESERVED_TAKE;
+    bool take_reserved=reserved==NG_RESERVED_TAKE, enabler_arena=false;
     startup_begin(signed_backend?"mapping the signed page container":"preparing execution memory",0);
     if (signed_backend)
         arena_ready=signed_image_prepare(guest.base+total,error,sizeof error);
@@ -1765,17 +1765,28 @@ bool ng_initialize(const char *path, const char *frameworks, const char *library
         arena_ready=nc_create_managed(&guest.arena,total,TKPrepareLocalArena,NULL,&local_quarantine);
 #endif
     else if(take_reserved) {
-        guest.arena=reserved_arena; reserved_arena=(NativeCodeMemory){0}; arena_ready=true;
+        guest.arena=reserved_arena; reserved_arena=(NativeCodeMemory){0}; arena_ready=true; enabler_arena=true;
         LOG("[native] using the arena reserved earlier: %zu bytes\n",guest.arena.size);
     }
     else if(external) {
         // An enabler first; otherwise an arena of our own.
-        arena_ready=da_request_arena(&guest.arena,total,guest.log);
+        arena_ready=enabler_arena=da_request_arena(&guest.arena,total,guest.log);
         if(!arena_ready) arena_ready=nc_create_managed(&guest.arena,total,prepare_externally,NULL,&external_quarantine);
     }
     else
         arena_ready=nc_create(&guest.arena,total,publish,NULL);
     if (!arena_ready) { LOG("[native] arena preparation failed errno=%d %s; guest entry blocked\n",errno,signed_backend?error:""); goto done; }
+    if (enabler_arena) {
+        // An enabler's region is not zero-filled memory: preparing a page writes
+        // into it (StikDebug stores one byte, 0x69, at the start of every page),
+        // and only pages the image has bytes for are written below. The image's
+        // zero-fill must read as zero. What the image does not use, reserved
+        // before its size was known and touched page by page, is given back.
+        size_t reserved_size=guest.arena.size;
+        memset(guest.arena.writable,0,total);
+        bool trimmed=nc_trim(&guest.arena,total);
+        LOG("[native] enabler arena cleared for %zu bytes; %zu of %zu bytes kept%s\n",total,guest.arena.size,reserved_size,trimmed?"":" (the unused tail could not be given back)");
+    }
     // A protection change can be reported and not granted.
     LOG("[native] arena protection %#x\n",hd_protection(guest.arena.executable));
     // Whichever route prepared it: nothing attached, really executable.
diff --git a/tests/test_native_memory.c b/tests/test_native_memory.c
--- a/tests/test_native_memory.c
+++ b/tests/test_native_memory.c
@@ -101,6 +101,35 @@ int main(void) {
     // Adopted, the region is ours: teardown unmaps it with the alias.
     assert(!mapped(foreign) && !mapped(alias));

+    // An enabler's region arrives sized before its user is known, and touched:
+    // StikDebug stores one byte, 0x69, at the start of every page it prepares.
+    // The user clears what it keeps through the writable view; nc_trim gives
+    // the rest of both views back.
+    void *wide=mmap(NULL,4*page,PROT_READ|PROT_EXEC,MAP_PRIVATE|MAP_ANON,-1,0);
+    if(wide==MAP_FAILED) wide=mmap(NULL,4*page,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0);
+    assert(wide!=MAP_FAILED);
+    NativeCodeMemory kept={0};
+    assert(!nc_trim(&kept,page) && errno==EINVAL);        // nothing adopted
+    assert(!nc_trim(&quarantine,page) && errno==EINVAL);  // quarantine is never touched
+    assert(nc_adopt(&kept,wide,4*page));
+    void *wide_alias=kept.writable; unsigned char mark=0x69;
+    for(size_t i=0;i<4;i++) assert(nc_write(&kept,i*page,&mark,1));
+    assert(!nc_trim(&kept,0) && errno==EINVAL);
+    assert(!nc_trim(&kept,4*page+1) && errno==EINVAL);
+    assert(nc_trim(&kept,4*page) && kept.size==4*page);   // nothing to give back
+    memset(kept.writable,0,page+1);
+    assert(nc_trim(&kept,page+1) && kept.size==2*page);   // rounded up to a page
+    assert(kept.executable==wide && kept.writable==wide_alias);
+    assert(((unsigned char *)wide)[0]==0 && ((unsigned char *)wide)[page]==0);
+    assert(mapped((char *)wide+page) && mapped((char *)wide_alias+page));
+    assert(!mapped((char *)wide+2*page) && !mapped((char *)wide+3*page));
+    assert(!mapped((char *)wide_alias+2*page) && !mapped((char *)wide_alias+3*page));
+    assert(!nc_write(&kept,2*page,data,sizeof data));     // past the new end
+    assert(nc_write(&kept,2*page-sizeof data,data,sizeof data));
+    assert(!memcmp((char *)wide+2*page-sizeof data,data,sizeof data));
+    nc_destroy(&kept);
+    assert(!mapped(wide) && !mapped(wide_alias));
+
     unsigned old_calls=calls;
     assert(!nc_create_managed(&memory,page,uncertain_pages,&calls,&quarantine) && errno==EINVAL);
     assert(calls==old_calls); // No second helper attempt or allocation.
@@ -120,5 +149,5 @@ int main(void) {
     assert(!nc_create_managed(&large,(size_t)NC_MAX_ARENA+page,accept_without_reading,NULL,&spare) && errno==EINVAL);
     assert(!large.executable && !large.writable);
     puts("PASS: native alias coherence, bounds, rejection cleanup, uncertain quarantine, write/retry denial (no generated code executed)");
-    puts("PASS: device-sized arena limit, adopted regions (no generated code executed)");
+    puts("PASS: device-sized arena limit, adopted and trimmed regions (no generated code executed)");
 }
