# WolkaraForever layer patch 0018 - Metal: presentation-time frame statistics
#
# Why: the optional performance HUD needs the frame rate and frame duration the
# game is actually presenting, measured where Metal reports it rather than
# inferred from a display link. The contribution added this to Presentation.m;
# here it is a patch so platform/ stays upstream's.
#
# What it does: records the presented time of each drawable in a 60-entry ring
# under a short unfair lock and publishes AKMetalCurrentFPS and
# AKMetalLastFrameTimeMs for the HUD to look up by name. It is observational
# only - no readback, no drawable flag change, no guest memory.
#
# It does nothing until it is asked to. The first version of this patch deleted
# the early return and added a presented handler to every drawable of every run,
# HUD or no HUD: a block allocation, a registration and a lock per frame, and a
# drawable retained until its callback ran. The swizzle is still installed once
# (the HUD can be switched on at any time and nextDrawable is only hookable
# before the first frame), but observedNextDrawable returns the drawable
# untouched unless the visible HUD enables it or a diagnostic flag is set. The
# HUD disables recording when hidden, so its handlers cannot linger on the game
# frame path for the rest of a session.
#
# Applies to: translation/Metal/Presentation.m
# Upstream: candidate (not submitted).
#
diff --git a/translation/Metal/Presentation.m b/translation/Metal/Presentation.m
index cc51ecd..5254185 100644
--- a/translation/Metal/Presentation.m
+++ b/translation/Metal/Presentation.m
@@ -1,4 +1,5 @@
 #import <QuartzCore/CAMetalLayer.h>
+#import <QuartzCore/QuartzCore.h>
 #import <Metal/Metal.h>
 #import <CoreGraphics/CoreGraphics.h>
 #import <ImageIO/ImageIO.h>
@@ -6,6 +7,70 @@
 #import "AKSupport.h"
 #include <stdatomic.h>
 #include <dlfcn.h>
+#include <os/lock.h>
+
+// Presentation-time frame statistics, for the optional performance HUD.
+//
+// This is measurement, not rendering: it only records the timestamps Metal
+// already reports when a drawable is presented, under a short lock. It reads no
+// guest memory, changes no drawable flag and never captures a frame. The HUD
+// looks these two functions up by name, so the adapter stays usable without it.
+#define AK_FPS_HISTORY_COUNT 60
+static double s_fpsTimestamps[AK_FPS_HISTORY_COUNT];
+static NSUInteger s_fpsHead = 0;
+static NSUInteger s_fpsCount = 0;
+static os_unfair_lock s_fpsLock = OS_UNFAIR_LOCK_INIT;
+static double s_cachedFPS = 0.0;
+static double s_lastFrameDurationMs = 0.0;
+static double s_lastPresentedAt = 0.0;
+
+void AKRecordMetalFramePresented(double timestamp) {
+    if (timestamp <= 0.0) timestamp = CACurrentMediaTime();
+    os_unfair_lock_lock(&s_fpsLock);
+    if (s_lastPresentedAt > 0.0) {
+        double delta = timestamp - s_lastPresentedAt;
+        if (delta > 0.0) s_lastFrameDurationMs = delta * 1000.0;
+    }
+    s_lastPresentedAt = timestamp;
+    s_fpsTimestamps[s_fpsHead] = timestamp;
+    s_fpsHead = (s_fpsHead + 1) % AK_FPS_HISTORY_COUNT;
+    if (s_fpsCount < AK_FPS_HISTORY_COUNT) s_fpsCount++;
+    if (s_fpsCount >= 2) {
+        NSUInteger oldest = (s_fpsHead + AK_FPS_HISTORY_COUNT - s_fpsCount) % AK_FPS_HISTORY_COUNT;
+        NSUInteger newest = (s_fpsHead + AK_FPS_HISTORY_COUNT - 1) % AK_FPS_HISTORY_COUNT;
+        double span = s_fpsTimestamps[newest] - s_fpsTimestamps[oldest];
+        if (span > 0.001) s_cachedFPS = (double)(s_fpsCount - 1) / span;
+    }
+    os_unfair_lock_unlock(&s_fpsLock);
+}
+
+__attribute__((visibility("default"))) double AKMetalCurrentFPS(void) {
+    os_unfair_lock_lock(&s_fpsLock);
+    double fps = s_cachedFPS;
+    double last = s_lastPresentedAt;
+    os_unfair_lock_unlock(&s_fpsLock);
+    // A stale average describes frames that are no longer arriving: report no
+    // measurement rather than a frame rate the game is not running at.
+    if (last > 0.0 && (CACurrentMediaTime() - last) > 0.5) return 0.0;
+    return fps;
+}
+
+__attribute__((visibility("default"))) double AKMetalLastFrameTimeMs(void) {
+    os_unfair_lock_lock(&s_fpsLock);
+    double ms = s_lastFrameDurationMs;
+    os_unfair_lock_unlock(&s_fpsLock);
+    return ms;
+}
+
+// Recording is off until something asks for it.
+//
+// The presented handler below allocates a block and takes a lock on every single frame. That
+// is a fair price for the HUD and no price at all for a player who has it switched off, so the
+// swizzle is installed always but the work inside it is gated by this flag - the same shape as
+// the readback opt-in below, and for the same reason.
+static atomic_bool s_recordFrames = false;
+__attribute__((visibility("default"))) void AKEnableMetalFrameStatistics(void) { atomic_store(&s_recordFrames, true); }
+__attribute__((visibility("default"))) void AKDisableMetalFrameStatistics(void) { atomic_store(&s_recordFrames, false); }
 
 // Development-only presentation evidence. All normal execution stays native.
