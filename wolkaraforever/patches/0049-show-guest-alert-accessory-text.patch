# Preserve the text that a guest puts in an NSAlert accessory NSTextView.
# Without this minimal bridge a fatal startup dialog has only its title, which
# hides the condition needed to diagnose it. A known damaged-installation
# alert is handed to the launcher so it can offer the user a real repair path.
--- a/translation/AppKit/Alerts.m
+++ b/translation/AppKit/Alerts.m
@@ -1,17 +1,48 @@
 #import "AppKit.h"
 // Alert configuration is a desktop model and may be built on a worker thread.
 // Only presentation creates UIKit objects, always on the main thread.
+@interface NSTextView : AKStubObject
+@property(copy) NSString *string;
+@property BOOL editable, drawsBackground;
+- (instancetype)initWithFrame:(NSRect)frame;
+@end
+@implementation NSTextView { NSString *_string; }
+- (instancetype)initWithFrame:(NSRect)frame { (void)frame; return [super init]; }
+- (NSString *)string { return _string; }
+- (void)setString:(NSString *)string {
+    _string=[string copy];
+    AKLog(@"guest alert text view: %@",_string);
+}
+- (void)insertText:(id)text replacementRange:(NSRange)range {
+    (void)range;
+    NSString *value=[text isKindOfClass:NSString.class] ? text : [text description];
+    self.string=[(self.string ?: @"") stringByAppendingString:value ?: @""];
+}
+- (id)textStorage { return self; }
+- (void)setAttributedString:(id)text {
+    NSString *value=[text isKindOfClass:NSString.class] ? text :
+        ([text respondsToSelector:@selector(string)] ? [text string] : [text description]);
+    self.string=value;
+}
+- (void)appendAttributedString:(id)text {
+    NSString *value=[text respondsToSelector:@selector(string)] ? [text string] : [text description];
+    self.string=[(self.string ?: @"") stringByAppendingString:value ?: @""];
+}
+@end
+
