# Copy to local.test.env (ignored) to operate the permanent test installation.
# These values must not equal TOLKARA_BUNDLE_ID or TOLKARA_KEYCHAIN_GROUP in local.env.
TOLKARA_TEST_BUNDLE_ID=local.wolkaraforever.yourname.test
TOLKARA_TEST_KEYCHAIN_GROUP=local.wolkaraforever.yourname.test.authorization
TOLKARA_TEST_DISPLAY_NAME="WolkaraForever Test"
# Defaults to DEVICE from local.env when blank. Set only when the test app is on another iPad.
#TOLKARA_TEST_DEVICE=
# Defaults to DEVELOPMENT_TEAM from local.env when blank.
#TOLKARA_TEST_DEVELOPMENT_TEAM=
