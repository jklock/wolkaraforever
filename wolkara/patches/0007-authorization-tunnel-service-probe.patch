# Wolkara layer patch 0007 - authorization: retire a failed packet service probe
#
# Why: a mobile-network transition can make the local service available again.
# Only a probe that failed before its first TCP connection is recreated, and the old
# tuple is retained so its delayed packets can never reach the reflector.
# Applies to: authorization/Tunnel/LocalPacketProvider.m, PacketServiceProbe.swift
# Upstream: candidate (not submitted).
#
diff --git a/authorization/Tunnel/LocalPacketProvider.m b/authorization/Tunnel/LocalPacketProvider.m
